{
  "dashboard": {
    "title": "EtherTrack - Database",
    "uid": "ethertrack-database",
    "tags": ["ethertrack", "database", "postgresql"],
    "timezone": "browser",
    "refresh": "10s",
    "panels": [
      {
        "title": "Connection Pool",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {"expr": "ethertrack_db_pool_active", "legendFormat": "Active"},
          {"expr": "ethertrack_db_pool_idle", "legendFormat": "Idle"},
          {"expr": "ethertrack_db_pool_total", "legendFormat": "Total"}
        ]
      },
      {
        "title": "Query Rate",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {"expr": "sum(rate(ethertrack_db_queries_total[5m])) by (operation)", "legendFormat": "{{operation}}"}
        ]
      },
      {
        "title": "P99 Query Latency",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {"expr": "histogram_quantile(0.99, sum(rate(ethertrack_db_query_duration_seconds_bucket[5m])) by (le, operation))", "legendFormat": "{{operation}}"}
        ]
      },
      {
        "title": "Query Error Rate",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {"expr": "sum(rate(ethertrack_db_queries_total{result=\"error\"}[5m])) by (operation)", "legendFormat": "{{operation}}"}
        ]
      },
      {
        "title": "Pool Utilization %",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 16, "w": 6, "h": 6},
        "targets": [
          {"expr": "ethertrack_db_pool_active / ethertrack_db_pool_total * 100"}
        ]
      }
    ]
  }
}