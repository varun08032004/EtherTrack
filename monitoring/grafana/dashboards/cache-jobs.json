{
  "dashboard": {
    "title": "EtherTrack - Cache & Background Jobs",
    "uid": "ethertrack-cache-jobs",
    "tags": ["ethertrack", "cache", "redis", "jobs", "background"],
    "timezone": "browser",
    "refresh": "10s",
    "panels": [
      {
        "title": "Redis Hit/Miss Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {"expr": "sum(rate(ethertrack_redis_hits_total[5m])) by (cache_type)", "legendFormat": "Hits - {{cache_type}}"},
          {"expr": "sum(rate(ethertrack_redis_misses_total[5m])) by (cache_type)", "legendFormat": "Misses - {{cache_type}}"}
        ]
      },
      {
        "title": "Redis Errors",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {"expr": "sum(rate(ethertrack_redis_errors_total[5m])) by (operation)", "legendFormat": "{{operation}}"}
        ]
      },
      {
        "title": "Background Job Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {"expr": "sum(rate(ethertrack_job_total[5m])) by (job, result)", "legendFormat": "{{job}} - {{result}}"}
        ]
      },
      {
        "title": "P99 Job Duration",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {"expr": "histogram_quantile(0.99, sum(rate(ethertrack_job_duration_seconds_bucket[5m])) by (le, job))", "legendFormat": "{{job}}"}
        ]
      },
      {
        "title": "ERP Sync Status",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {"expr": "sum(rate(ethertrack_erp_sync_total[5m])) by (erp, operation, result)", "legendFormat": "{{erp}} - {{operation}} - {{result}}"}
        ]
      },
      {
        "title": "Backup Status",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {"expr": "sum(rate(ethertrack_backup_total[1h])) by (type, result)", "legendFormat": "{{type}} - {{result}}"}
        ]
      }
    ]
  }
}