# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit real credentials to git

# Server
PORT=5000
NODE_ENV=development

# Database (Supabase Postgres)
# Use connection pooling via PgBouncer (port 6543)
DATABASE_URL=postgresql://postgres:password@host:6543/postgres
SUPABASE_URL=postgresql://postgres:password@host:6543/postgres

# Supabase Service Role (BACKEND ONLY - NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Frontend URL (for CORS, email links, etc.)
FRONTEND_URL=http://localhost:3000

# JWT Secrets (rotate regularly in production)
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Firebase Admin SDK (Backend only)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Redis (Upstash or self-hosted)
REDIS_URL=redis://localhost:6379
# For Upstash: rediss://default:token@host:6379

# Email (SendGrid, Resend, or SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_SUPPORT_FROM=support@yourdomain.com
EMAIL_ADMIN_FROM=admin@yourdomain.com
EMAIL_BILLING_FROM=billing@yourdomain.com
EMAIL_SALES_FROM=sales@yourdomain.com

# SMTP (alternative to Resend)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
SMTP_FROM=support@yourdomain.com

# Pinata IPFS
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Razorpay (Test mode for development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_ACCOUNT_NUMBER=your_account_number
RAZORPAY_MERCHANT_ACCOUNT_ID=your_merchant_account_id
RAZORPAY_NODAL_ACCOUNT_ID=your_nodal_account_id

# Company fund account for fee sweeps
COMPANY_FUND_ACCOUNT_ID=your_fund_account_id
COMPANY_USER_ID=your_company_user_id

# Blockchain
# Network: sepolia (chainId: 11155111) or polygon (chainId: 137)
CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://rpc.sepolia.org
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_NETWORK=sepolia

# Contract Addresses (update after deployment)
KYC_REGISTRY_ADDRESS=
TREASURY_ADDRESS=
CARBON_CREDIT_TOKEN_ADDRESS=
EMISSION_REGISTRY_ADDRESS=
MARKETPLACE_ADDRESS=
AMM_POOL_ADDRESS=
AUDIT_CONTRACT_ADDRESS=
CREDIT_LEDGER_ADDRESS=
TIMELOCK_CONTROLLER_ADDRESS=

# Blockchain Private Keys (BACKEND ONLY - NEVER expose to frontend)
# These are operator wallets with specific on-chain roles
MINTER_PRIVATE_KEY=0xyour_minter_private_key
CHAIN_SIGNER_PRIVATE_KEY=0xyour_chain_signer_private_key
SIGNER_WALLET=0xyour_signer_wallet_address
RELAYER_PRIVATE_KEY=0xyour_relayer_private_key
SIGNER_WALLET=0xyour_relayer_wallet_address
CHAIN_SIGNER_PRIVATE_KEY=0xyour_chain_signer_private_key
POLYGON_RPC_URL=https://polygon-rpc.com

# ALCHEMY/ANKR RPC (used by backend services)
ALCHEMY_RPC=https://rpc.ankr.com/eth_sepolia/your_key

# Chain logging
CHAIN_SIGNER_PRIVATE_KEY=0xyour_chain_signer_private_key
SIGNER_WALLET=0xyour_signer_wallet_address
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_NETWORK=sepolia
COMPANY_USER_ID=your_company_user_id
COMPANY_FUND_ACCOUNT_ID=your_fund_account_id

# Relaying for audit trail
RELAYER_PRIVATE_KEY=0xyour_relayer_private_key
AUDIT_CONTRACT_ADDRESS=
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Firebase Admin (Backend only)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Encryption/Signing
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

TOTP_ENCRYPTION_KEY=your_32_byte_hex_key_64_chars
COOKIE_SECRET=your_cookie_secret_at_least_32_chars

# Pinata IPFS
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Sentry
SENTRY_DSN=https://xxx@o0.ingest.sentry.io/xxx

# ERP Credentials Encryption
ERP_CREDS_KEY=your_32_byte_hex_key_64_chars

# Admin
ADMIN_EMAIL=admin@yourdomain.com

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
SMTP_FROM=support@yourdomain.com

# Email Queue (Nodemailer/SMTP)
SMTP_SUPPORT_FROM=support@yourdomain.com
SMTP_ADMIN_FROM=admin@yourdomain.com

# Redis (Upstash)
REDIS_URL=redis://localhost:6379
# For Upstash: rediss://default:token@host:6379

# GCI Registry (Grid Controller of India)
GCI_API_URL=https://registry.gridindia.in/api/v1
GCI_API_KEY=
GCI_ENTITY_CODE=

# IEX (Indian Energy Exchange)
IEX_API_URL=https://api.iexindia.com/ccc/v1
IEX_API_KEY=
IEX_CLIENT_ID=

# PXIL (Power Exchange India Ltd)
PXIL_API_URL=https://api.pxil.co.in/ccc/v1
PXIL_API_KEY=
PXIL_CLIENT_ID=

# Email logo
EMAIL_LOGO_URL=https://yourdomain.com/logo.png
BACKEND_URL=https://yourdomain.com

# Ops Integration (internal ERP sync)
OPS_SYNC_SERVICE_TOKEN=your_ops_sync_token
PLATFORM_SYNC_CORPORATE_WRITE_TOKEN=your_corporate_write_token
PLATFORM_SYNC_COUPON_WRITE_TOKEN=your_coupon_write_token
PLATFORM_SYNC_PRICING_WRITE_TOKEN=your_pricing_write_token

# ERP Credentials Encryption Key
ERP_CREDS_KEY=your_32_byte_hex_key_64_chars

# Base URL for OAuth callbacks
BASE_URL=https://yourdomain.com

# NVIDIA API (example placeholder)
nvapi-your_nvidia_api_key