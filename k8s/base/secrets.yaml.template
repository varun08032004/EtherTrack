# EtherTrack - Secrets Template (DO NOT COMMIT ACTUAL SECRETS)
# Apply with: kubectl apply -f secrets.yaml
# Generate with: kubectl create secret generic ethertrack-secrets --from-literal=key=value --dry-run=client -o yaml > secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: ethertrack-secrets
  namespace: ethertrack
  labels:
    app: ethertrack
type: Opaque
stringData:
  # Database
  database-url: "postgresql://ethertrack:CHANGE_ME@postgres:5432/ethertrack?sslmode=require"
  redis-url: "redis://:CHANGE_ME@redis:6379/0"

  # Authentication
  jwt-secret: "CHANGE_ME_MIN_32_CHARS"
  jwt-refresh-secret: "CHANGE_ME_MIN_32_CHARS"
  totp-encryption-key: "CHANGE_ME_32_BYTES_BASE64"
  cookie-secret: "CHANGE_ME_MIN_32_CHARS"

  # Razorpay
  razorpay-key-id: "rzp_test_CHANGE_ME"
  razorpay-key-secret: "CHANGE_ME"
  razorpay-webhook-secret: "CHANGE_ME"

  # Pinata / IPFS
  pinata-api-key: "CHANGE_ME"
  pinata-secret-key: "CHANGE_ME"

  # Blockchain / Alchemy
  alchemy-rpc: "https://eth-sepolia.g.alchemy.com/v2/CHANGE_ME"
  kyc-registry-address: "0xCHANGE_ME"

  # Sentry
  sentry-dsn: "https://CHANGE_ME@o123456.ingest.sentry.io/123456"

  # Fallback
  eth-inr-fallback: "85.00"

  # SMTP
  smtp-host: "smtp.gmail.com"
  smtp-user: "CHANGE_ME"
  smtp-pass: "CHANGE_ME"
  smtp-from: "noreply@ethertrack.in"

  # ERP
  erp-creds-key: "CHANGE_ME_32_BYTES_BASE64"

  # Ops Integration
  platform-sync-corporate-write-token: "CHANGE_ME"
  platform-sync-coupon-write-token: "CHANGE_ME"
  platform-sync-pricing-write-token: "CHANGE_ME"

  # Chain Logging
  chain-signer-private-key: "CHANGE_ME_64_HEX_CHARS"
  signer-wallet: "0xCHANGE_ME"
  polygon-rpc-url: "https://polygon-rpc.com"
  polygon-network: "sepolia"
  company-user-id: "CHANGE_ME_UUID"
  company-fund-account-id: "CHANGE_ME"

  # Ops Integration Tokens
  platform-sync-corporate-write-token: "CHANGE_ME"
  platform-sync-coupon-write-token: "CHANGE_ME"
  platform-sync-pricing-write-token: "CHANGE_ME"