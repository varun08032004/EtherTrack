# Frontend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit real credentials to git

# Firebase Configuration (Client-side config - safe to expose in browser)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Supabase Configuration (Client-side config - anon key is safe for browser)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Carbon Markets API
REACT_APP_CARBONMARK_API_KEY=your_carbonmark_api_key
REACT_APP_CARBON_API_TOKEN=your_carbon_api_token
REACT_APP_CARBON_API_SECRET=your_carbon_api_secret
REACT_APP_WALLET_API_TOKEN=your_wallet_api_token
REACT_APP_WALLET_API_SECRET=your_wallet_api_secret

# Blockchain Network
REACT_APP_CHAIN_ID=11155111
REACT_APP_NETWORK_NAME=sepolia

# Contract Addresses (Sepolia Testnet)
REACT_APP_KYC_REGISTRY_ADDRESS=0x...
REACT_APP_TREASURY_ADDRESS=0x...
REACT_APP_CARBON_CREDIT_TOKEN_ADDRESS=0x...
REACT_APP_EMISSION_REGISTRY_ADDRESS=0x...
REACT_APP_MARKETPLACE_ADDRESS=0x...
REACT_APP_AMM_POOL_ADDRESS=0x...
REACT_APP_AUDIT_CONTRACT_ADDRESS=0x...
REACT_APP_CREDIT_LEDGER_ADDRESS=0x...
REACT_APP_TIMELOCK_CONTROLLER_ADDRESS=0x...

# API
REACT_APP_API_URL=http://localhost:5000

# Email (Resend) - Only key ID, not secret
REACT_APP_RESEND_API_KEY=re_...

# Razorpay (Test mode only - key ID is public, secret must NEVER be in frontend)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_...
# REACT_APP_RAZORPAY_KEY_SECRET=  # NEVER PUT SECRET IN FRONTEND - REMOVED FOR SECURITY

# Sentry (DSN is public)
REACT_APP_SENTRY_DSN=https://...

# App Version
REACT_APP_VERSION=1.0.0