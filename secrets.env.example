# EtherTrack - Local Development Secrets
# Copy to secrets.env and fill in actual values
# DO NOT COMMIT THIS FILE WITH ACTUAL SECRETS

# Database
DATABASE_URL=postgresql://ethertrack:ethertrack_dev_password@localhost:5432/ethertrack
DATABASE_READ_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min_32_chars
TOTP_ENCRYPTION_KEY=dev_totp_encryption_key_32_bytes_base64
COOKIE_SECRET=dev_cookie_secret_change_in_production_min_32_chars

# Razorpay
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Pinata / IPFS
PINATA_API_KEY=CHANGE_ME
PINATA_SECRET_KEY=CHANGE_ME

# Blockchain / Alchemy
ALCHEMY_RPC=https://eth-sepolia.g.alchemy.com/v2/CHANGE_ME
KYC_REGISTRY_ADDRESS=0xCHANGE_ME

# Sentry
SENTRY_DSN=https://CHANGE_ME@o123456.ingest.sentry.io/123456

# Fallback
ETH_INR_FALLBACK=85.00

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Base URL
BASE_URL=http://localhost:5000

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@ethertrack.in
ADMIN_EMAIL=admin@ethertrack.in

# ERP
ERP_CREDS_KEY=CHANGE_ME_32_BYTES_BASE64

# Ops Integration
PLATFORM_SYNC_CORPORATE_WRITE_TOKEN=CHANGE_ME
PLATFORM_SYNC_COUPON_WRITE_TOKEN=CHANGE_ME
PLATFORM_SYNC_PRICING_WRITE_TOKEN=CHANGE_ME

# Chain Logging
CHAIN_SIGNER_PRIVATE_KEY=CHANGE_ME_64_HEX_CHARS
SIGNER_WALLET=0xCHANGE_ME
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_NETWORK=sepolia
COMPANY_USER_ID=CHANGE_ME_UUID
COMPANY_FUND_ACCOUNT_ID=CHANGE_ME

# Ops Integration Tokens
PLATFORM_SYNC_CORPORATE_WRITE_TOKEN=CHANGE_ME
PLATFORM_SYNC_COUPON_WRITE_TOKEN=CHANGE_ME
PLATFORM_SYNC_PRICING_WRITE_TOKEN=CHANGE_ME